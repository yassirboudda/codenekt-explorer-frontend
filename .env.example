# CodeNekt L1 Explorer Frontend Configuration

# Public environment variables (accessible in browser)
PUBLIC_RPC_URL=https://rpc1.codenekt-ecosystem.io/
PUBLIC_GAS_UNIT=Gwei
PUBLIC_NATIVE_SYMBOL=CDK

# Private environment variables (server-side only)
EXPLORER_API_URL=http://localhost:3000
DB_STRING=mongodb://localhost:27017
DB_NAME=codenekt_explorer

# Native symbol fallback
NATIVE_SYMBOL=CDK

# Optional: Sourcify verify URL for contract verification
# PUBLIC_SOURCIFY_VERIFY_URL=
